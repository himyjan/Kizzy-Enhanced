    <string name="discord_step1_title">Hatua ya 1: Fungua Mipangilio ya Faragha</string>
    <string name="console_detected">Imetambuliwa</string>
    <string name="discord_step2_title">Hatua ya 2: Washa Shiriki Shughuli</string>
    <string name="discord_step1_content">Fungua programu ya Discord → gusa aikoni yako "Wewe" (picha ya wasifu) → gusa Mipangilio (⚙️) → sogeza chini na gusa "Maudhui na Mtandao wa Kijamii" (au "Faragha ya Shughuli" kwenye toleo za zamani za programu).</string>
    <string name="activity_type_fallback_desc">Inatumika kwa programu haziotambuliwa, na kwa kila programu wakati utambuzi wa kiotomatiki umeshutwa.</string>
    <string name="discord_step3_title">Hatua ya 3: Angalia hali yako ya Mtandaoni</string>
